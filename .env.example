# Required — OpenRouter API key, used by the Verifier agent to call the LLM
# Get a free key at https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional — which OpenRouter model to use for generating explanations/fixes.
# If unset, agents/verifier/run.ts falls back to openai/gpt-oss-20b:free.
# Free model IDs on OpenRouter can change or get delisted without notice —
# check openrouter.ai/models (free filter) if this stops working.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
